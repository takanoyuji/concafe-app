# Airレジ API 接続設定のひな形。
#
# 本番サーバーの /opt/apps/concafe-app/.airregi.env にコピーして値を入れる。
#   - このファイル自体（.example）にはキーを書かない。リポジトリに入るため
#   - 実ファイルは chmod 600 にする
#   - キーとトークンは Airレジ「データ連携API設定」画面で店舗ごとに確認・発行する
#
# Airレジ API は固定IP制限があり、申請時に登録したIP（219.94.244.166）からしか叩けない。
# 開発機（WSL）からは動かないので、実行は本番サーバー上で行う。

# 対象店舗のスラッグ。スペース区切り
AIRREGI_STORES="tokyo osaka nagoya"

# 生JSONの保存先
AIRREGI_RAW_DIR="/opt/apps/concafe-app/airregi-raw"

# 店舗ごとのキー（13桁）とトークン（32桁）
# tokyo  = 星狼 池袋
# osaka  = 星狼 日本橋
# nagoya = 星狼 名古屋栄
AIRREGI_KEY_tokyo=""
AIRREGI_TOKEN_tokyo=""

AIRREGI_KEY_osaka=""
AIRREGI_TOKEN_osaka=""

AIRREGI_KEY_nagoya=""
AIRREGI_TOKEN_nagoya=""
