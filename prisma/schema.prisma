generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  role               String    @default("CUSTOMER")
  emailVerified      Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  birthdate          DateTime?
  ageVerified        Boolean   @default(false)
  name               String?
  favoriteStoreId    String?
  favoriteCast1Id    String?
  favoriteCast2Id    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  ledgerFrom          PointLedger[] @relation("LedgerFromUser")
  ledgerTo            PointLedger[] @relation("LedgerToUser")
}

model Store {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  address   String
  mapQuery  String
  createdAt DateTime @default(now())

  castStores CastStore[]
}

/// キャストの唯一のマスタ。
///
/// 以前は HP掲載用の Cast と給与計算用の CastMaster に分かれていたが、
/// 同じ人物が2箇所に散っていて突き合わせが名前頼りだったため、1つに統合した。
/// HPに出すかどうかは isPublished（表示FLG）で決める。
///
/// id は絶対に振り直さない。ポイント履歴とユーザーのお気に入りが参照している。
model Cast {
  id       String @id @default(cuid())
  /// 外部システム（remodri 等）から参照するための不変コード。C0001 形式。
  /// 一度振ったら変えない。採番は lib/castCode.ts が行う
  castCode String @unique @default("")
  name     String

  /// HP（公開ページ）に表示するか。false なら一切出さない
  isPublished Boolean @default(false)
  /// 退職FLG。給与集計の対象から外れる
  retired     Boolean @default(false)

  // --- HP掲載用 ---
  bio          String  @default("")
  imageUrl     String  @default("")
  twitterUrl   String?
  instagramUrl String?
  tiktokUrl    String?
  order        Int     @default(0)
  /// ランク。未設定は空文字（給与計算が空文字を「ランクなし」として扱うため null にしない）
  rank         String  @default("")

  // --- 給与計算用（エアレジ / エアシフト の名寄せ表）---
  airShiftName          String?
  exemptFromCommuteRule Boolean @default(false)
  tokyoAirRegi          String  @default("")
  tokyoAirShift         String  @default("")
  osakaAirRegi          String  @default("")
  osakaAirShift         String  @default("")
  nagoyaAirRegi         String  @default("")
  nagoyaAirShift        String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores       CastStore[]
  ledgerItems  PointLedger[]
  monthlyRanks CastMonthlyRank[]

  @@index([isPublished, retired])
}

/// キャストの所属店舗。掛け持ちがいるので複数持てる。
/// isPrimary が「主たる店舗」で、HPではこの店舗のページに出る。1人につき1つだけ true。
model CastStore {
  id        String  @id @default(cuid())
  castId    String
  storeId   String
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  cast  Cast  @relation(fields: [castId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([castId, storeId])
  @@index([storeId, isPrimary])
}

model CastMonthlyRank {
  id        String   @id @default(cuid())
  castId    String
  year      Int
  month     Int // 1-12
  rank      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cast Cast @relation(fields: [castId], references: [id], onDelete: Cascade)

  @@unique([castId, year, month])
}

// 半月ごとの給与計算結果
model SalaryPeriod {
  id          String   @id @default(cuid())
  storeName   String
  year        Int
  month       Int      // 1-12
  half        Int      // 1=前半(1-15日), 2=後半(16日-末日)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeName, year, month, half])

  castRecords   SalaryCastRecord[]
  summaryRecord SalarySummaryRecord?
}

model SalaryCastRecord {
  id          String @id @default(cuid())
  periodId    String
  castName    String
  hpName      String @default("")
  rank        String @default("")
  basicPay    Float  @default(0)
  commute     Float  @default(0)
  back        Float  @default(0)
  payment     Float  @default(0)
  grossProfit Float  @default(0)
  totalSales  Float  @default(0)

  period SalaryPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model SalarySummaryRecord {
  id                 String @id @default(cuid())
  periodId           String @unique
  totalSalesTaxIncl  Float  @default(0)
  remoteSales        Float  @default(0)
  localSales         Float  @default(0)
  taxAmount          Float  @default(0)
  grossProfit        Float  @default(0)
  purchases          Float  @default(0)
  castPay            Float  @default(0)
  laborCost          Float  @default(0)
  contributionProfit Float  @default(0)
  workHours          String @default("")

  period SalaryPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model CastRank {
  id        String   @id @default(cuid())
  name      String   @unique
  backRate  Float
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model PointLedger {
  id             String   @id @default(cuid())
  type           String
  amount         Int
  fromUserId     String?
  toUserId       String?
  castId         String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  fromUser User? @relation("LedgerFromUser", fields: [fromUserId], references: [id])
  toUser   User? @relation("LedgerToUser", fields: [toUserId], references: [id])
  cast     Cast? @relation(fields: [castId], references: [id])
}

model Title {
  id        String   @id @default(cuid())
  name      String
  threshold Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
