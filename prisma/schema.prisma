generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  role               String    @default("CUSTOMER")
  emailVerified      Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  birthdate          DateTime?
  ageVerified        Boolean   @default(false)
  name               String?
  favoriteStoreId    String?
  favoriteCast1Id    String?
  favoriteCast2Id    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  ledgerFrom          PointLedger[] @relation("LedgerFromUser")
  ledgerTo            PointLedger[] @relation("LedgerToUser")
}

model Store {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  address   String
  mapQuery  String
  createdAt DateTime @default(now())

  casts Cast[]
}

model Cast {
  id                   String   @id @default(cuid())
  name                 String
  bio                  String
  imageUrl             String
  storeId              String
  order                Int      @default(0)
  isPublished          Boolean  @default(true) // false = HP（公開ページ）に一切表示しない
  twitterUrl           String?
  instagramUrl         String?
  tiktokUrl            String?
  airShiftName         String?
  rank                 String?
  exemptFromCommuteRule Boolean @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  store       Store         @relation(fields: [storeId], references: [id])
  ledgerItems PointLedger[]
}

model CastMaster {
  id             String   @id @default(cuid())
  // 外部システム（remodri 等）から参照するための不変コード。C0001 形式。
  // 一度振ったら変えない。採番は lib/castCode.ts が行う（DB のデフォルトは使わない）
  castCode       String   @unique @default("")
  hpName         String   @default("")   // HP上の名前（空ならHP未掲載）
  rank           String   @default("")
  retired        Boolean  @default(false) // 退職FLG
  tokyoAirRegi   String   @default("")   // 東京 エアレジ名
  tokyoAirShift  String   @default("")   // 東京 エアシフト名
  osakaAirRegi   String   @default("")   // 大阪 エアレジ名
  osakaAirShift  String   @default("")   // 大阪 エアシフト名
  nagoyaAirRegi  String   @default("")   // 名古屋 エアレジ名
  nagoyaAirShift String   @default("")   // 名古屋 エアシフト名
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  monthlyRanks CastMonthlyRank[]
}

model CastMonthlyRank {
  id           String   @id @default(cuid())
  castMasterId String
  year         Int
  month        Int      // 1-12
  rank         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  castMaster CastMaster @relation(fields: [castMasterId], references: [id], onDelete: Cascade)

  @@unique([castMasterId, year, month])
}

// 半月ごとの給与計算結果
model SalaryPeriod {
  id          String   @id @default(cuid())
  storeName   String
  year        Int
  month       Int      // 1-12
  half        Int      // 1=前半(1-15日), 2=後半(16日-末日)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([storeName, year, month, half])

  castRecords   SalaryCastRecord[]
  summaryRecord SalarySummaryRecord?
}

model SalaryCastRecord {
  id          String @id @default(cuid())
  periodId    String
  castName    String
  hpName      String @default("")
  rank        String @default("")
  basicPay    Float  @default(0)
  commute     Float  @default(0)
  back        Float  @default(0)
  payment     Float  @default(0)
  grossProfit Float  @default(0)
  totalSales  Float  @default(0)

  period SalaryPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model SalarySummaryRecord {
  id                 String @id @default(cuid())
  periodId           String @unique
  totalSalesTaxIncl  Float  @default(0)
  remoteSales        Float  @default(0)
  localSales         Float  @default(0)
  taxAmount          Float  @default(0)
  grossProfit        Float  @default(0)
  purchases          Float  @default(0)
  castPay            Float  @default(0)
  laborCost          Float  @default(0)
  contributionProfit Float  @default(0)
  workHours          String @default("")

  period SalaryPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model CastRank {
  id        String   @id @default(cuid())
  name      String   @unique
  backRate  Float
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model PointLedger {
  id             String   @id @default(cuid())
  type           String
  amount         Int
  fromUserId     String?
  toUserId       String?
  castId         String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  fromUser User? @relation("LedgerFromUser", fields: [fromUserId], references: [id])
  toUser   User? @relation("LedgerToUser", fields: [toUserId], references: [id])
  cast     Cast? @relation(fields: [castId], references: [id])
}

model Title {
  id        String   @id @default(cuid())
  name      String
  threshold Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
