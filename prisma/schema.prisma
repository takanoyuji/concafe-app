generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               String    @default("CUSTOMER")
  emailVerified      Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  birthdate          DateTime?
  ageVerified        Boolean   @default(false)
  name               String?
  favoriteStoreId    String?
  favoriteCast1Id    String?
  favoriteCast2Id    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  ledgerFrom          PointLedger[]            @relation("LedgerFromUser")
  ledgerTo            PointLedger[]            @relation("LedgerToUser")
}

model Store {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  address   String
  mapQuery  String
  createdAt DateTime @default(now())

  /// Airレジの店舗番号（13桁。例 AKR6612359648）。取り込み時に、生JSONの storeNo が
  /// これと一致するかを必ず照合する。一致しなければ取り込まない。
  /// 別店舗のデータを取り込んでしまう事故を、データ層で止めるためのもの。
  /// 空文字なら未設定＝その店舗はAPI連携していない、と扱う。
  airRegiStoreNo String @default("")

  castStores CastStore[]
}

/// キャストの唯一のマスタ。
///
/// 以前は HP掲載用の Cast と給与計算用の CastMaster に分かれていたが、
/// 同じ人物が2箇所に散っていて突き合わせが名前頼りだったため、1つに統合した。
/// HPに出すかどうかは isPublished（表示FLG）で決める。
///
/// id は絶対に振り直さない。ポイント履歴とユーザーのお気に入りが参照している。
model Cast {
  id       String @id @default(cuid())
  /// 外部システム（remodri 等）から参照するための不変コード。C0001 形式。
  /// 一度振ったら変えない。採番は lib/castCode.ts が行う
  castCode String @unique @default("")
  name     String

  /// HP（公開ページ）に表示するか。false なら一切出さない
  isPublished Boolean @default(false)
  /// 退職FLG。給与集計の対象から外れる
  retired     Boolean @default(false)

  // --- HP掲載用 ---
  bio          String  @default("")
  imageUrl     String  @default("")
  twitterUrl   String?
  instagramUrl String?
  tiktokUrl    String?
  order        Int     @default(0)
  /// ランク。未設定は空文字（給与計算が空文字を「ランクなし」として扱うため null にしない）
  rank         String  @default("")

  // --- 給与計算用（エアレジ / エアシフト の名寄せ表）---
  airShiftName          String?
  exemptFromCommuteRule Boolean @default(false)
  tokyoAirRegi          String  @default("")
  tokyoAirShift         String  @default("")
  osakaAirRegi          String  @default("")
  osakaAirShift         String  @default("")
  nagoyaAirRegi         String  @default("")
  nagoyaAirShift        String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stores       CastStore[]
  ledgerItems  PointLedger[]
  monthlyRanks CastMonthlyRank[]

  @@index([isPublished, retired])
}

/// キャストの所属店舗。掛け持ちがいるので複数持てる。
/// isPrimary が「主たる店舗」で、HPではこの店舗のページに出る。1人につき1つだけ true。
model CastStore {
  id        String  @id @default(cuid())
  castId    String
  storeId   String
  isPrimary Boolean @default(false)
  order     Int     @default(0)

  cast  Cast  @relation(fields: [castId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([castId, storeId])
  @@index([storeId, isPrimary])
}

model CastMonthlyRank {
  id        String   @id @default(cuid())
  castId    String
  year      Int
  month     Int // 1-12
  rank      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cast Cast @relation(fields: [castId], references: [id], onDelete: Cascade)

  @@unique([castId, year, month])
}

// 半月ごとの給与計算結果
model SalaryPeriod {
  id        String   @id @default(cuid())
  storeName String
  year      Int
  month     Int // 1-12
  half      Int // 1=前半(1-15日), 2=後半(16日-末日)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  castRecords   SalaryCastRecord[]
  summaryRecord SalarySummaryRecord?

  @@unique([storeName, year, month, half])
}

model SalaryCastRecord {
  id          String @id @default(cuid())
  periodId    String
  castName    String
  /// 計算時点の Cast.name の写し。給与明細は後から変わってはいけないので参照ではなく値で持つ。
  /// Cast 側の列名変更に巻き込んで一括置換しないこと（2026-08-14 にこれで保存が落ちた）
  hpName      String @default("")
  rank        String @default("")
  basicPay    Float  @default(0)
  commute     Float  @default(0)
  back        Float  @default(0)
  payment     Float  @default(0)
  grossProfit Float  @default(0)
  totalSales  Float  @default(0)

  period SalaryPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model SalarySummaryRecord {
  id                 String @id @default(cuid())
  periodId           String @unique
  totalSalesTaxIncl  Float  @default(0)
  remoteSales        Float  @default(0)
  localSales         Float  @default(0)
  taxAmount          Float  @default(0)
  grossProfit        Float  @default(0)
  purchases          Float  @default(0)
  castPay            Float  @default(0)
  laborCost          Float  @default(0)
  contributionProfit Float  @default(0)
  workHours          String @default("")

  period SalaryPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
}

model CastRank {
  id        String   @id @default(cuid())
  name      String   @unique
  backRate  Float
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model PointLedger {
  id             String   @id @default(cuid())
  type           String
  amount         Int
  fromUserId     String?
  toUserId       String?
  castId         String?
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  fromUser User? @relation("LedgerFromUser", fields: [fromUserId], references: [id])
  toUser   User? @relation("LedgerToUser", fields: [toUserId], references: [id])
  cast     Cast? @relation(fields: [castId], references: [id])
}

model Title {
  id        String   @id @default(cuid())
  name      String
  threshold Int
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MenuItem {
  id        String   @id @default(cuid())
  imageUrl  String
  alt       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// Airレジ API から取り込んだ取引明細
//
// 原本は生JSON（サーバーの /opt/apps/concafe-app/airregi-raw/ と手元のバックアップ）。
// ここに入るのは集計に使う項目だけの写しで、生JSONはDBに持たない。
// 62日ぶんで展開8.2MBあり、DBに入れると日次バックアップが重くなるため。
//
// 取り込みは営業日単位で「まるごと削除 → 入れ直し」する。
// 会計金額修正・伝票削除が後日発生するので、同じ営業日を何度取り込んでも
// 最後の結果に収束する必要がある（冪等）。
// ============================================================

/// 取引ヘッダ（会計 or 返品が1件）
model AirRegiTransaction {
  id String @id @default(cuid())

  /// Airレジの店舗番号（13桁）。Store.airRegiStoreNo と照合済みの値
  storeNo   String
  /// Store.slug（tokyo / osaka / nagoya）。集計はこちらで引く
  storeSlug String

  /// Airレジの取引ID（32桁）
  airRegiTransactionId String
  /// 0:会計 1:返品。⚠️ 返品も totalAmount がプラス値で返るので、集計時に減算すること
  transactionType      String
  /// 1 なら伝票削除済み。集計から外す
  canceledFlg          String @default("0")

  /// 店舗の業務日付を加味した営業日 YYYYMMDD。期間の切り出しは必ずこれで行う
  /// （3店舗とも業務日付の変更時間は5時。実時刻 transactionDateTime とはズレる）
  businessDate        String
  transactionDateTime String
  voucherNo           String @default("")

  /// 割引・割増をすべて含んだ税込金額
  totalAmount    Int
  taxAmount      Int @default(0)
  /// 全体割引の合計（割引はマイナス値）。伝票単位なので商品明細には按分できない
  discountAmount Int @default(0)

  /// 生JSONの取得日時。再取り込みの要否判定に使う
  fetchedAt  DateTime
  importedAt DateTime @default(now())

  orders   AirRegiOrder[]
  payments AirRegiPayment[]

  @@unique([storeNo, airRegiTransactionId])
  @@index([storeSlug, businessDate])
}

/// 注文明細。Airレジのバリエーション単位で1行
model AirRegiOrder {
  id            String @id @default(cuid())
  transactionId String

  productId    String @default("")
  productName  String
  categoryId   String @default("")
  /// 星狼ではここにキャスト名が入る（遠隔は "遠隔_" 接頭辞つき）。給与のバックはこれで名寄せする
  categoryName String @default("")

  variationName1 String @default("")
  variationName2 String @default("")

  orderCount      Int
  /// 個別割引の適用後の単価
  discountedPrice Int
  /// 個別割引・割増の合計（割引はマイナス値）。明細に紐づくので按分は不要
  discountTotal   Int    @default(0)
  /// 0:内税 1:外税
  taxType         String @default("0")
  taxRate         String @default("")
  /// 1個あたりの原価。未設定商品は0が返る（TC・飲み放題・入場料などが該当）
  cost            Int    @default(0)

  transaction AirRegiTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

/// 支払方法別の内訳。給与計算では使わない。
/// Airペイの実効料率を明細で定点観測するために取っている（後から遡って取得できないため）
model AirRegiPayment {
  id            String @id @default(cuid())
  transactionId String

  paymentMethodName String
  /// 000:現金 050:外部連携決済(Airペイ等) 101:商品券 102:売掛金
  paymentType       String
  amount            Int

  transaction AirRegiTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
}

/// 営業日ごとの取り込み結果。
/// 「取れていない営業日」を管理画面に出すための台帳。
/// これが無いと、cronが静かに止まっても誰も気づけない。
model AirRegiSyncLog {
  id           String @id @default(cuid())
  storeSlug    String
  /// YYYYMMDD
  businessDate String

  /// ok / error
  status           String @default("ok")
  transactionCount Int    @default(0)
  message          String @default("")

  /// 生JSON側の取得日時。ファイルがこれより新しければ取り込み直す
  fetchedAt  DateTime
  importedAt DateTime @default(now())

  @@unique([storeSlug, businessDate])
  @@index([businessDate])
}
